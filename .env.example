# 腰有据 · 环境变量示例（复制为 .env 后按需修改；仓库不保存任何真实密钥）

# ---------- server ----------
PORT=3200
DB_DIR=./data
# 身份隔离库字段加密密钥（AES-256-GCM，base64；不设置时仅本地演示可用）
IDENTITY_ENCRYPTION_KEY=
# 演示短信验证码（短信通道为演示实现，只写日志）
DEMO_SMS_CODE=123456
# 后台 TOTP 演示固定码
ADMIN_TOTP_DEMO_CODE=123456
# 后台演示账号登录密码（演示固定值）
ADMIN_DEMO_PASSWORD=123456
# 后台令牌签名密钥（HMAC-SHA256；未设置时用派生密钥，仅限本地演示）
ADMIN_TOKEN_SECRET=
# 审计链头锚点校验和密钥（HMAC-SHA256；未设置时在 DB_DIR/.audit-anchor-key 生成随机密钥文件）
AUDIT_ANCHOR_KEY=
# Worker 轮询间隔（毫秒）
WORKER_POLL_INTERVAL_MS=1500
