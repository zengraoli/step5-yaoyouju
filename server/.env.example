# 服务端配置示例。复制为 .env 后按需修改；.env 与 data/ 不提交到仓库。
# API 服务端口（约定端口 3200）
PORT=3200
NODE_ENV=development

# SQLite 数据文件位置（相对 server/ 目录）
DB_DIR=./data

# 身份隔离库字段加密密钥（AES-256-GCM，32 字节，base64）。
# 生成方式示例（Node）：require('crypto').randomBytes(32).toString('base64')
IDENTITY_ENCRYPTION_KEY=

# 演示用固定短信验证码（brief：验证码固定为 123456，只写日志，手机号脱敏）
DEMO_SMS_CODE=123456

# 后台 TOTP 演示固定码
ADMIN_TOTP_DEMO_CODE=123456

# 任务 Worker 轮询间隔（毫秒）
WORKER_POLL_INTERVAL_MS=1500
